{
  "name": "disastersos",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "npx expo start",
    "android": "npx expo start --android",
    "ios": "npx expo start --ios",
    "web": "npx expo start --web",
    "build": "npx expo export -p web && node scripts/inject-pwa-tags.js",
    "postinstall": "node -e \"const fs=require('fs'),path=require('path'),nm='node_modules';if(fs.existsSync(nm)){function walk(dir){fs.readdirSync(dir).forEach(f=>{const full=path.join(dir,f);if(f.startsWith('.'))return;if(f==='package.json'){try{const json=JSON.parse(fs.readFileSync(full,'utf8'));let ch=false;['react-native','source'].forEach(k=>{if(json[k]&&typeof json[k]==='string'){const t=path.join(path.dirname(full),json[k]);if(!fs.existsSync(t)&&!fs.existsSync(t+'.js')&&!fs.existsSync(t+'.ts')&&!fs.existsSync(t+'.tsx')){if(json.main&&fs.existsSync(path.join(path.dirname(full),json.main)))json[k]=json.main;else if(json.module&&fs.existsSync(path.join(path.dirname(full),json.module)))json[k]=json.module;else delete json[k];ch=true;}}});if(ch)fs.writeFileSync(full,JSON.stringify(json,null,2));}catch(e){}}else if(fs.statSync(full).isDirectory())walk(full);});}walk(nm);\""
  },
  "dependencies": {
    "@expo/metro-runtime": "^57.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "^7.4.8",
    "@react-navigation/drawer": "^7.8.1",
    "@react-navigation/native": "^7.1.18",
    "@react-navigation/stack": "^7.4.9",
    "axios": "^1.12.2",
    "expo": "~57.0.0",
    "expo-application": "~57.0.3",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-image-manipulator": "~57.0.17",
    "expo-location": "~57.0.17",
    "expo-notifications": "~57.0.18",
    "expo-print": "~57.0.2",
    "expo-sharing": "~57.0.19",
    "expo-status-bar": "~57.0.1",
    "fbjs": "^3.0.5",
    "geolib": "^3.3.4",
    "invariant": "^2.2.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "react-native": "0.86.3",
    "react-native-element-dropdown": "^2.12.4",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "socket.io-client": "^4.8.3",
    "warning": "^4.0.3"
  },
  "private": true,
  "devDependencies": {
    "babel-preset-expo": "~57.0.0",
    "react-native-dotenv": "^3.4.11"
  }
}
