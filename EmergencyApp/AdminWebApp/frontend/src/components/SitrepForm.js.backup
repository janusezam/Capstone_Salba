import React, { useState, useEffect } from 'react';
import { AlertCircle, CheckCircle, Save, Send, Download } from 'lucide-react';

const SitrepForm = ({ rescue }) => {
  const [templateType, setTemplateType] = useState('SITREP1');
  const [activeTab, setActiveTab] = useState('situation');
  const [loading, setLoading] = useState(false);
  const [saving, setSaving] = useState(false);
  const [status, setStatus] = useState('Draft');
  const [templateSelected, setTemplateSelected] = useState(false);

  // Get auth token from localStorage
  const getAuthHeader = () => {
    const token = localStorage.getItem('token');
    return token ? { 'Authorization': `Bearer ${token}` } : {};
  };

  // Default SITREP structure with all required fields
  const defaultSitrep = {
    reportId: rescue._id,
    situationOverview: '',
    affectedPopulation: [],
    casualties: { dead: 0, injured: 0, missing: 0 },
    damageAssessment: { houses: 0, crops: 0, livestock: 0, infrastructure: '' },
    lifelines: {
      roads: { status: 'Accessible', description: '' },
      electricity: { status: 'Operational', description: '' },
      water: { status: 'Available', description: '' },
      communication: { status: 'Operational', description: '' }
    },
    reliefAssistance: { foodPacks: 0, waterJugs: 0, blankets: 0, medicines: 0, remarks: '' },
    teamsDeployed: [],
    administrativeActions: {
      suspensionOfClasses: false,
      suspensionOfWork: false,
      declarationOfCalamity: false
    }
  };

  // Merge API response with defaults to ensure all fields exist
  const mergeSitrepDefaults = (apiData) => {
    return {
      ...defaultSitrep,
      ...apiData,
      casualties: { ...defaultSitrep.casualties, ...(apiData.casualties || {}) },
      damageAssessment: { ...defaultSitrep.damageAssessment, ...(apiData.damageAssessment || {}) },
      lifelines: {
        roads: { ...defaultSitrep.lifelines.roads, ...(apiData.lifelines?.roads || {}) },
        electricity: { ...defaultSitrep.lifelines.electricity, ...(apiData.lifelines?.electricity || {}) },
        water: { ...defaultSitrep.lifelines.water, ...(apiData.lifelines?.water || {}) },
        communication: { ...defaultSitrep.lifelines.communication, ...(apiData.lifelines?.communication || {}) }
      },
      reliefAssistance: { ...defaultSitrep.reliefAssistance, ...(apiData.reliefAssistance || {}) },
      affectedPopulation: Array.isArray(apiData.affectedPopulation) ? apiData.affectedPopulation : [],
      teamsDeployed: Array.isArray(apiData.teamsDeployed) ? apiData.teamsDeployed : [],
      administrativeActions: { ...defaultSitrep.administrativeActions, ...(apiData.administrativeActions || {}) }
    };
  };

  const [sitrep, setSitrep] = useState(defaultSitrep);

  // Fetch existing SITREP on component mount
  useEffect(() => {
    const fetchSitrep = async () => {
      try {
        setLoading(true);
        const response = await fetch(`http://192.168.1.56:5000/api/sitrep/${rescue._id}`, {
          headers: { 'Content-Type': 'application/json', ...getAuthHeader() }
        });
        const data = await response.json();
        
        if (data.sitrep) {
          setSitrep(mergeSitrepDefaults(data.sitrep));
          setStatus(data.sitrep.status || 'Draft');
        } else {
          setSitrep(defaultSitrep);
        }
      } catch (error) {
        console.error('Error fetching SITREP:', error);
        setSitrep(defaultSitrep);
      } finally {
        setLoading(false);
      }
    };

    if (rescue._id) {
      fetchSitrep();
    }
  }, [rescue._id]);

  // Handle template selection - just select, don't download
  const handleTemplateSelect = (template) => {
    setTemplateType(template);
    setTemplateSelected(true);
    console.log(`✓ ${template} template selected`);
  };

  const handleSaveDraft = async () => {
    try {
      setSaving(true);
      const payload = { ...sitrep, status: 'Draft' };
      
      const response = await fetch('http://192.168.1.56:5000/api/sitrep', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', ...getAuthHeader() },
        body: JSON.stringify(payload)
      });

      if (response.ok) {
        const data = await response.json();
        setStatus('Draft');
        alert('SITREP saved as draft');
      } else {
        alert('Error saving SITREP');
      }
    } catch (error) {
      console.error('Error saving SITREP:', error);
      alert('Error saving SITREP: ' + error.message);
    } finally {
      setSaving(false);
    }
  };

  const handleSubmit = async () => {
    if (!window.confirm('Submit SITREP for approval? This cannot be undone.')) return;

    try {
      setSaving(true);
      const response = await fetch(`http://192.168.1.56:5000/api/sitrep/${rescue._id}/submit`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', ...getAuthHeader() }
      });

      if (response.ok) {
        setStatus('Submitted');
        alert('SITREP submitted for approval');
      } else {
        alert('Error submitting SITREP');
      }
    } catch (error) {
      console.error('Error submitting SITREP:', error);
      alert('Error submitting SITREP: ' + error.message);
    } finally {
      setSaving(false);
    }
  };

  const handleExportWord = async () => {
    try {
      setSaving(true);
      
      // First save the form data
      const payload = { ...sitrep, status };
      await fetch('http://192.168.1.56:5000/api/sitrep', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', ...getAuthHeader() },
        body: JSON.stringify(payload)
      });
      
      // Then export to Word
      const response = await fetch(`http://192.168.1.56:5000/api/sitrep/${rescue._id}/export-word`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', ...getAuthHeader() },
        body: JSON.stringify({ templateType })
      });
      
      if (response.ok) {
        const blob = await response.blob();
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `SITREP_${rescue._id}_${new Date().toISOString().slice(0, 10)}.docx`;
        document.body.appendChild(a);
        a.click();
        window.URL.revokeObjectURL(url);
        document.body.removeChild(a);
        alert('SITREP exported successfully');
      } else {
        alert('Error exporting SITREP');
      }
    } catch (error) {
      console.error('Error exporting SITREP:', error);
      alert('Error exporting SITREP: ' + error.message);
    } finally {
      setSaving(false);
    }
  };

  const handleAddBarangay = () => {
    setSitrep(prev => ({
      ...prev,
      affectedPopulation: [...prev.affectedPopulation, { barangay: '', families: 0, persons: 0 }]
    }));
  };

  const handleRemoveBarangay = (index) => {
    setSitrep(prev => ({
      ...prev,
      affectedPopulation: prev.affectedPopulation.filter((_, i) => i !== index)
    }));
  };

  const handleAddTeam = () => {
    setSitrep(prev => ({
      ...prev,
      teamsDeployed: [...prev.teamsDeployed, { teamName: '', numberOfMembers: 0, deploymentTime: new Date().toISOString() }]
    }));
  };

  const handleRemoveTeam = (index) => {
    setSitrep(prev => ({
      ...prev,
      teamsDeployed: prev.teamsDeployed.filter((_, i) => i !== index)
    }));
  };

  const tabs = [
    { id: 'situation', label: '1. Situation Overview' },
    { id: 'population', label: '2a. Affected Population' },
    { id: 'idp', label: '2b. IDP Center Profile' },
    { id: 'lifelines', label: '2c. Lifelines' },
    { id: 'houses', label: '2d. Damage to Houses' },
    ...(templateType === 'SITREP2' 
      ? [{ id: 'agriculture', label: '2e. Agriculture' }]
      : [{ id: 'agriculture', label: '2e. Crops & Livestock' }]
    ),
    { id: 'admin', label: '2f. Administrative Actions' },
    { id: 'actions', label: '3. Actions Taken' }
  ];

  return (
    <div className="bg-white rounded-lg border border-slate-200 p-6">
      <div className="flex items-center justify-between mb-4">
        <h4 className="font-semibold text-slate-900">Situation Report (SITREP)</h4>
        <div className="flex items-center gap-2">
          <span className={`px-3 py-1 rounded-full text-xs font-medium ${
            status === 'Draft' ? 'bg-yellow-100 text-yellow-700' :
            status === 'Submitted' ? 'bg-blue-100 text-blue-700' :
            'bg-green-100 text-green-700'
          }`}>
            {status}
          </span>
        </div>
      </div>

      {/* Template Selector */}
      <div className="mb-6 pb-4 border-b border-slate-200">
        <p className="text-sm font-medium text-slate-700 mb-2">Select Template Type:</p>
        <div className="flex gap-3">
          <button
            onClick={() => handleTemplateSelect('SITREP1')}
            className={`px-4 py-2 rounded-lg font-medium transition-colors ${
              templateType === 'SITREP1'
                ? 'bg-blue-600 text-white'
                : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
            }`}
          >
            📋 SITREP1 (Standard)
          </button>
          <button
            onClick={() => handleTemplateSelect('SITREP2')}
            className={`px-4 py-2 rounded-lg font-medium transition-colors ${
              templateType === 'SITREP2'
                ? 'bg-blue-600 text-white'
                : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
            }`}
          >
            📋 SITREP2 (Detailed)
          </button>
        </div>
        <p className="text-xs text-slate-500 mt-2">Select the template format above. Fill form below and click "Export as Word" to generate and download your report.</p>
      </div>

      {loading ? (
        <div className="flex items-center justify-center py-8">
          <p className="text-slate-600">Loading SITREP...</p>
        </div>
      ) : (
        <>
          {/* Tab Navigation */}
          <div className="flex flex-wrap gap-2 mb-6 border-b border-slate-200 pb-3">
            {tabs.map(tab => (
              <button
                key={tab.id}
                onClick={() => setActiveTab(tab.id)}
                className={`px-3 py-2 text-sm font-medium rounded-lg transition-colors ${
                  activeTab === tab.id
                    ? 'bg-blue-600 text-white'
                    : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
                }`}
              >
                {tab.label}
              </button>
            ))}
          </div>

          {/* Tab Content */}
          <div className="space-y-4 mb-6 max-h-96 overflow-y-auto">
            {/* Situation Overview Tab */}
            {activeTab === 'situation' && (
              <div className="space-y-4">
                <div>
                  <label className="block text-sm font-medium text-slate-700 mb-2">Situation Overview</label>
                  <textarea
                    value={sitrep.situationOverview}
                    onChange={(e) => setSitrep(prev => ({ ...prev, situationOverview: e.target.value }))}
                    placeholder="Describe the current disaster situation, weather, and conditions..."
                    className="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    rows="5"
                  />
                </div>
              </div>
            )}

            {/* Affected Population Tab */}
            {activeTab === 'population' && (
              <div className="space-y-4">
                {sitrep.affectedPopulation.map((pop, idx) => (
                  <div key={idx} className="p-4 border border-slate-200 rounded-lg space-y-3">
                    <input
                      type="text"
                      placeholder="Barangay name"
                      value={pop.barangay}
                      onChange={(e) => {
                        const updated = [...sitrep.affectedPopulation];
                        updated[idx].barangay = e.target.value;
                        setSitrep(prev => ({ ...prev, affectedPopulation: updated }));
                      }}
                      className="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    />
                    <div className="grid grid-cols-2 gap-3">
                      <input
                        type="number"
                        placeholder="Families affected"
                        value={pop.families}
                        onChange={(e) => {
                          const updated = [...sitrep.affectedPopulation];
                          updated[idx].families = parseInt(e.target.value) || 0;
                          setSitrep(prev => ({ ...prev, affectedPopulation: updated }));
                        }}
                        className="px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                      />
                      <input
                        type="number"
                        placeholder="Persons affected"
                        value={pop.persons}
                        onChange={(e) => {
                          const updated = [...sitrep.affectedPopulation];
                          updated[idx].persons = parseInt(e.target.value) || 0;
                          setSitrep(prev => ({ ...prev, affectedPopulation: updated }));
                        }}
                        className="px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                      />
                    </div>
                    <button
                      onClick={() => handleRemoveBarangay(idx)}
                      className="w-full px-3 py-2 bg-red-100 text-red-700 hover:bg-red-200 rounded-lg text-sm font-medium transition-colors"
                    >
                      Remove
                    </button>
                  </div>
                ))}
                <button
                  onClick={handleAddBarangay}
                  className="w-full px-4 py-2 bg-blue-600 text-white hover:bg-blue-700 rounded-lg font-medium transition-colors"
                >
                  + Add Barangay
                </button>
              </div>
            )}

            {/* Casualties Tab */}
            {activeTab === 'casualties' && (
              <div className="grid grid-cols-3 gap-4">
                <div>
                  <label className="block text-sm font-medium text-slate-700 mb-2">Dead</label>
                  <input
                    type="number"
                    min="0"
                    value={sitrep.casualties.dead}
                    onChange={(e) => setSitrep(prev => ({
                      ...prev,
                      casualties: { ...prev.casualties, dead: parseInt(e.target.value) || 0 }
                    }))}
                    className="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                  />
                </div>
                <div>
                  <label className="block text-sm font-medium text-slate-700 mb-2">Injured</label>
                  <input
                    type="number"
                    min="0"
                    value={sitrep.casualties.injured}
                    onChange={(e) => setSitrep(prev => ({
                      ...prev,
                      casualties: { ...prev.casualties, injured: parseInt(e.target.value) || 0 }
                    }))}
                    className="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                  />
                </div>
                <div>
                  <label className="block text-sm font-medium text-slate-700 mb-2">Missing</label>
                  <input
                    type="number"
                    min="0"
                    value={sitrep.casualties.missing}
                    onChange={(e) => setSitrep(prev => ({
                      ...prev,
                      casualties: { ...prev.casualties, missing: parseInt(e.target.value) || 0 }
                    }))}
                    className="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                  />
                </div>
              </div>
            )}

            {/* Damage Assessment Tab */}
            {activeTab === 'damage' && (
              <div className="space-y-4">
                <div>
                  <label className="block text-sm font-medium text-slate-700 mb-2">Houses Damaged</label>
                  <input
                    type="number"
                    min="0"
                    value={sitrep.damageAssessment.houses}
                    onChange={(e) => setSitrep(prev => ({
                      ...prev,
                      damageAssessment: { ...prev.damageAssessment, houses: parseInt(e.target.value) || 0 }
                    }))}
                    className="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                  />
                </div>
                <div>
                  <label className="block text-sm font-medium text-slate-700 mb-2">Crops Damaged (hectares)</label>
                  <input
                    type="number"
                    min="0"
                    value={sitrep.damageAssessment.crops}
                    onChange={(e) => setSitrep(prev => ({
                      ...prev,
                      damageAssessment: { ...prev.damageAssessment, crops: parseInt(e.target.value) || 0 }
                    }))}
                    className="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                  />
                </div>
                <div>
                  <label className="block text-sm font-medium text-slate-700 mb-2">Livestock Lost</label>
                  <input
                    type="number"
                    min="0"
                    value={sitrep.damageAssessment.livestock}
                    onChange={(e) => setSitrep(prev => ({
                      ...prev,
                      damageAssessment: { ...prev.damageAssessment, livestock: parseInt(e.target.value) || 0 }
                    }))}
                    className="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                  />
                </div>
                <div>
                  <label className="block text-sm font-medium text-slate-700 mb-2">Infrastructure Damage</label>
                  <textarea
                    value={sitrep.damageAssessment.infrastructure}
                    onChange={(e) => setSitrep(prev => ({
                      ...prev,
                      damageAssessment: { ...prev.damageAssessment, infrastructure: e.target.value }
                    }))}
                    placeholder="Describe infrastructure damage..."
                    className="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    rows="3"
                  />
                </div>
              </div>
            )}

            {/* Lifelines Tab */}
            {activeTab === 'lifelines' && (
              <div className="space-y-4">
                {['roads', 'electricity', 'water', 'communication'].map(lifeline => (
                  <div key={lifeline} className="p-4 border border-slate-200 rounded-lg space-y-3">
                    <label className="block text-sm font-medium text-slate-700 capitalize">{lifeline}</label>
                    <select
                      value={sitrep.lifelines[lifeline].status}
                      onChange={(e) => setSitrep(prev => ({
                        ...prev,
                        lifelines: {
                          ...prev.lifelines,
                          [lifeline]: { ...prev.lifelines[lifeline], status: e.target.value }
                        }
                      }))}
                      className="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    >
                      <option value="Operational">Operational</option>
                      <option value="Partially Operational">Partially Operational</option>
                      <option value="Non-Operational">Non-Operational</option>
                      <option value="Accessible">Accessible</option>
                      <option value="Partially Accessible">Partially Accessible</option>
                      <option value="Inaccessible">Inaccessible</option>
                      <option value="Available">Available</option>
                      <option value="Limited">Limited</option>
                      <option value="Not Available">Not Available</option>
                    </select>
                    <textarea
                      value={sitrep.lifelines[lifeline].description}
                      onChange={(e) => setSitrep(prev => ({
                        ...prev,
                        lifelines: {
                          ...prev.lifelines,
                          [lifeline]: { ...prev.lifelines[lifeline], description: e.target.value }
                        }
                      }))}
                      placeholder={`Describe ${lifeline} status...`}
                      className="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                      rows="2"
                    />
                  </div>
                ))}
              </div>
            )}

            {/* Relief Assistance Tab */}
            {activeTab === 'relief' && (
              <div className="space-y-4">
                <div className="grid grid-cols-2 gap-3">
                  <div>
                    <label className="block text-sm font-medium text-slate-700 mb-2">Food Packs</label>
                    <input
                      type="number"
                      min="0"
                      value={sitrep.reliefAssistance.foodPacks}
                      onChange={(e) => setSitrep(prev => ({
                        ...prev,
                        reliefAssistance: { ...prev.reliefAssistance, foodPacks: parseInt(e.target.value) || 0 }
                      }))}
                      className="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    />
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-slate-700 mb-2">Water Jugs</label>
                    <input
                      type="number"
                      min="0"
                      value={sitrep.reliefAssistance.waterJugs}
                      onChange={(e) => setSitrep(prev => ({
                        ...prev,
                        reliefAssistance: { ...prev.reliefAssistance, waterJugs: parseInt(e.target.value) || 0 }
                      }))}
                      className="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    />
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-slate-700 mb-2">Blankets</label>
                    <input
                      type="number"
                      min="0"
                      value={sitrep.reliefAssistance.blankets}
                      onChange={(e) => setSitrep(prev => ({
                        ...prev,
                        reliefAssistance: { ...prev.reliefAssistance, blankets: parseInt(e.target.value) || 0 }
                      }))}
                      className="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    />
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-slate-700 mb-2">Medicines</label>
                    <input
                      type="number"
                      min="0"
                      value={sitrep.reliefAssistance.medicines}
                      onChange={(e) => setSitrep(prev => ({
                        ...prev,
                        reliefAssistance: { ...prev.reliefAssistance, medicines: parseInt(e.target.value) || 0 }
                      }))}
                      className="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    />
                  </div>
                </div>
                <div>
                  <label className="block text-sm font-medium text-slate-700 mb-2">Additional Remarks</label>
                  <textarea
                    value={sitrep.reliefAssistance.remarks}
                    onChange={(e) => setSitrep(prev => ({
                      ...prev,
                      reliefAssistance: { ...prev.reliefAssistance, remarks: e.target.value }
                    }))}
                    placeholder="Any additional remarks on relief assistance..."
                    className="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    rows="3"
                  />
                </div>
              </div>
            )}

            {/* Teams Deployed Tab */}
            {activeTab === 'teams' && (
              <div className="space-y-4">
                {sitrep.teamsDeployed.map((team, idx) => (
                  <div key={idx} className="p-4 border border-slate-200 rounded-lg space-y-3">
                    <input
                      type="text"
                      placeholder="Team name"
                      value={team.teamName}
                      onChange={(e) => {
                        const updated = [...sitrep.teamsDeployed];
                        updated[idx].teamName = e.target.value;
                        setSitrep(prev => ({ ...prev, teamsDeployed: updated }));
                      }}
                      className="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    />
                    <input
                      type="number"
                      placeholder="Number of members"
                      value={team.numberOfMembers}
                      onChange={(e) => {
                        const updated = [...sitrep.teamsDeployed];
                        updated[idx].numberOfMembers = parseInt(e.target.value) || 0;
                        setSitrep(prev => ({ ...prev, teamsDeployed: updated }));
                      }}
                      className="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    />
                    <button
                      onClick={() => handleRemoveTeam(idx)}
                      className="w-full px-3 py-2 bg-red-100 text-red-700 hover:bg-red-200 rounded-lg text-sm font-medium transition-colors"
                    >
                      Remove
                    </button>
                  </div>
                ))}
                <button
                  onClick={handleAddTeam}
                  className="w-full px-4 py-2 bg-blue-600 text-white hover:bg-blue-700 rounded-lg font-medium transition-colors"
                >
                  + Add Team
                </button>
              </div>
            )}

            {/* Administrative Actions Tab */}
            {activeTab === 'actions' && (
              <div className="space-y-4">
                <label className="flex items-center gap-3 p-4 border border-slate-200 rounded-lg hover:bg-slate-50 cursor-pointer">
                  <input
                    type="checkbox"
                    checked={sitrep.administrativeActions.suspensionOfClasses}
                    onChange={(e) => setSitrep(prev => ({
                      ...prev,
                      administrativeActions: { ...prev.administrativeActions, suspensionOfClasses: e.target.checked }
                    }))}
                    className="w-4 h-4"
                  />
                  <span className="font-medium text-slate-700">Suspension of Classes</span>
                </label>
                <label className="flex items-center gap-3 p-4 border border-slate-200 rounded-lg hover:bg-slate-50 cursor-pointer">
                  <input
                    type="checkbox"
                    checked={sitrep.administrativeActions.suspensionOfWork}
                    onChange={(e) => setSitrep(prev => ({
                      ...prev,
                      administrativeActions: { ...prev.administrativeActions, suspensionOfWork: e.target.checked }
                    }))}
                    className="w-4 h-4"
                  />
                  <span className="font-medium text-slate-700">Suspension of Work</span>
                </label>
                <label className="flex items-center gap-3 p-4 border border-slate-200 rounded-lg hover:bg-slate-50 cursor-pointer">
                  <input
                    type="checkbox"
                    checked={sitrep.administrativeActions.declarationOfCalamity}
                    onChange={(e) => setSitrep(prev => ({
                      ...prev,
                      administrativeActions: { ...prev.administrativeActions, declarationOfCalamity: e.target.checked }
                    }))}
                    className="w-4 h-4"
                  />
                  <span className="font-medium text-slate-700">Declaration of Calamity</span>
                </label>
              </div>
            )}
          </div>

          {/* Action Buttons */}
          <div className="flex gap-2 border-t border-slate-200 pt-4">
            <button
              onClick={handleExportWord}
              disabled={saving}
              className="flex-1 px-4 py-2 bg-green-600 hover:bg-green-700 disabled:bg-slate-300 text-white font-semibold rounded-lg transition-colors flex items-center justify-center gap-2"
            >
              {saving ? <span className="animate-spin">⏳</span> : <Download className="w-4 h-4" />}
              📥 Export as Word
            </button>
            <button
              onClick={handleSaveDraft}
              disabled={saving || status === 'Approved'}
              className="flex-1 px-4 py-2 bg-slate-600 hover:bg-slate-700 disabled:bg-slate-300 text-white font-semibold rounded-lg transition-colors flex items-center justify-center gap-2"
            >
              {saving ? <span className="animate-spin">⏳</span> : <Save className="w-4 h-4" />}
              Save as Draft
            </button>
            <button
              onClick={handleSubmit}
              disabled={saving || status === 'Submitted' || status === 'Approved'}
              className="flex-1 px-4 py-2 bg-blue-600 hover:bg-blue-700 disabled:bg-slate-300 text-white font-semibold rounded-lg transition-colors flex items-center justify-center gap-2"
            >
              {saving ? <span className="animate-spin">⏳</span> : <Send className="w-4 h-4" />}
              Submit for Approval
            </button>
          </div>
        </>
      )}
    </div>
  );
};

export default SitrepForm;
